// Cloudflare Workers static-assets config (assets-only: no Worker script).
// Deployed via Workers Builds connected to the GitHub repo, matching the
// other SMF Studio sites: pushes to main go to production, other branches
// get preview URLs. `pnpm run deploy` remains for manual publishes.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "onform",
  // SMF Studio account (not the personal finn@smfstudio.io account)
  "account_id": "3fb5d086d5ed5ca41cf07fcde76624f8",
  "compatibility_date": "2026-08-09",
  "assets": {
    "directory": "./dist",
    // SPA fallback: serve index.html for unknown paths so TanStack Router owns routing
    "not_found_handling": "single-page-application",
  },
}
